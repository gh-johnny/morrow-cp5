{
  "buildCommand": "npm run export:web",
  "installCommand": "npm ci && npm --prefix server ci",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|_expo/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
