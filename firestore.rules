rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'; }
    function member(id) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.memberIds; }
    match /directory/{uid} { allow read: if signedIn(); allow write: if false; }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /{path=**} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    }
    match /conversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
      match /{path=**} { allow read: if member(id); allow write: if false; }
    }
    match /{path=**} { allow read, write: if false; }
  }
}
