    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test": "vitest run",
    "test:rules": "npx firebase-tools@15 emulators:exec --config firebase.test.json --project demo-morrow --only firestore,database 'npm test -- tests/security.rules.test.ts'",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test",
    "api:dev": "npm --prefix server run dev",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx eas-cli@latest build --platform ios --profile simulator"
  },
  "private": true
}
